{
  "plugins": [
    {
      "id": "health",
      "type": "wasm",
      "path": "health.wasm",
      "load_time": "boot",
      "max_memory_mb": 128,
      "msg_per_second": 1000,
      "capabilities": [
        {"method": "health:status", "description": "Get system health status"}
      ]
    },
    {
      "id": "chat",
      "type": "wasm",
      "path": "chat.wasm",
      "load_time": "lazy",
      "max_memory_mb": 128,
      "msg_per_second": 1000,
      "capabilities": [
        {"method": "chat:send", "description": "Send a message"},
        {"method": "chat:history", "description": "Get history"},
        {"method": "ui:view:chat", "description": "Chat View"}
      ]
    },
    {
      "id": "buffer",
      "type": "wasm",
      "path": "buffer.wasm",
      "load_time": "boot",
      "max_memory_mb": 256,
      "msg_per_second": 1000,
      "capabilities": [
        {"method": "buffer:read", "description": "Read buffer"},
        {"method": "buffer:write", "description": "Write buffer"},
        {"method": "ui:view:editor", "description": "Editor View"}
      ]
    },
    {
      "id": "ai",
      "type": "wasm",
      "path": "ai.wasm",
      "load_time": "lazy",
      "max_memory_mb": 256,
      "msg_per_second": 500,
      "capabilities": [
        {"method": "ai:query", "description": "Query AI"}
      ]
    },
    {
      "id": "iam",
      "type": "wasm",
      "path": "iam.wasm",
      "load_time": "boot",
      "capabilities": [
        {"method": "iam:check", "description": "Check permissions"}
      ]
    },
    {
      "id": "project",
      "type": "wasm",
      "path": "project.wasm",
      "load_time": "boot",
      "capabilities": [
        {"method": "project:get_active", "description": "Get active project"}
      ]
    },
    {
      "id": "index",
      "type": "wasm",
      "path": "index.wasm",
      "load_time": "lazy",
      "capabilities": [
        {"method": "knowledge:search", "description": "Search index"}
      ]
    },
    {
      "id": "secrets",
      "type": "wasm",
      "path": "secrets.wasm",
      "load_time": "lazy"
    },
    {
      "id": "tasks",
      "type": "wasm",
      "path": "tasks.wasm",
      "load_time": "boot",
      "background": true
    },
    {
      "id": "team-presence",
      "type": "wasm",
      "path": "team-presence.wasm",
      "load_time": "boot"
    },
    {
      "id": "settings",
      "type": "wasm",
      "path": "settings.wasm",
      "load_time": "boot"
    }
  ]
}
