{
  "version": "1.0.0",
  "name": "Default Project",
  "description": "Standard Alloy Project Template",
  "layout": {
    "default_mode": "dashboard",
    "dashboard": {
      "tiles": [
        { "plugin": "project", "weight": 1 },
        { "plugin": "ai", "weight": 1 },
        { "plugin": "team", "weight": 1 },
        { "plugin": "chat", "weight": 2 }
      ]
    },
    "panes": [
      {
        "split": "vertical",
        "left": { "plugin": "buffer-manager" },
        "right": { "plugin": "chat" }
      }
    ]
  },
  "provision": {
    "wasm": ["project", "ai", "chat", "buffer"]
  }
}
