package alloy:api;

world alloy {
    import alloy: interface {
        // Message structure for plugin communication
        record message {
            id: string,
            msg-type: string,
            method: string,
            sender: string,
            target: option<string>,
            payload: list<u8>,
            timestamp: u64,
        }
        
        // Workspace structure
        record workspace {
            id: string,
            name: string,
            path: string,
            team-id: option<string>,
            metadata: list<tuple<string, string>>,
        }
        
        // Capability description for plugin registration
        record capability {
            method: string,
            description: string,
            shortcut: option<string>,
            annotations: option<list<tuple<string, string>>>,
        }
        
        // Plugin status
        enum status {
            running,
            paused,
            stopped,
            crashed,
        }
        
        // Initialize the plugin with its ID and capabilities
        init: func(id: string, caps: list<capability>);
        
        // Handle an incoming message
        handle-message: func(msg: message) -> message;
        
        // Log a message to the host
        log: func(level: string, message: string);
        
        // Key-value storage operations
        kv-set: func(key: string, value: list<u8>) -> bool;
        kv-get: func(key: string) -> option<list<u8>>;
        kv-delete: func(key: string) -> bool;
        kv-list: func(prefix: string) -> list<string>;
        
        // Message routing
        route-message: func(msg: message);
        
        // Synchronous call to another plugin
        call: func(msg: message) -> message;
        
        // Signal that the plugin is ready
        started: func();
        
        // Get the next message (for pull model)
        get-next-message: func() -> option<message>;
        
        // Send a response
        send-response: func(msg: message);
        
        // Save plugin state
        save-state: func() -> list<u8>;
        
        // Load plugin state
        load-state: func(state: list<u8>);

        // Workspace management
        get-active-workspace: func() -> option<workspace>;
        set-active-workspace: func(id: string);
        list-workspaces: func() -> list<workspace>;
        register-workspace: func(ws: workspace);
        unregister-workspace: func(id: string);
    }
}