#!/bin/bash
if [[ "$*" == *"--version"* ]]; then
  echo "wasm-opt version 110"
  exit 0
fi

OUT=""
IN=""
for ((i=1; i<=$#; i++)); do
  arg="${@:i:1}"
  if [[ "$arg" == "-o" ]]; then
    next_idx=$((i+1))
    OUT="${@:next_idx:1}"
    i=$next_idx
  elif [[ "$arg" != -* ]]; then
    IN="$arg"
  fi
done

if [[ -n "$OUT" ]]; then
  if [[ -n "$IN" && -f "$IN" ]]; then
    cp "$IN" "$OUT"
  else
    # TinyGo sometimes uses standard input? No, usually positional.
    # We must ensure the output file exists.
    touch "$OUT"
  fi
fi
exit 0
